# Copy to .env and replace every "replace-me". Docker Compose reads this file directly;
# for `./gradlew bootRun` either export the variables or activate the "local" Spring profile,
# which imports .env automatically.

# PostgreSQL / TimescaleDB
# DB_HOST and DB_PORT describe how the *backend* reaches the database. Under Docker Compose
# they are overridden to the internal service address; DB_PORT then only sets the host port mapping.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shelly
DB_USER=postgres
DB_PASSWORD=replace-me

# Google OAuth client (Web application type).
# Authorized redirect URI: http://localhost:8080/login/oauth2/code/google (adjust host for production)
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me

# Comma-separated Google account emails allowed to log in. Seeded into the users table on startup.
APP_ALLOWED_EMAILS=you@example.com

# Host port the dashboard listens on under Docker Compose
APP_PORT=8080

# Shelly Cloud
# Authorization code obtained from https://my.shelly.cloud/oauth_login.html?client_id=shelly-diy&redirect_uri=http://localhost:8080/
# The code embeds your Shelly server (user_api_url), which is used for the token exchange and always monitored for events.
SHELLY_AUTH_CODE=replace-me
SHELLY_CLIENT_ID=shelly-diy
# Comma-separated additional regions monitored for real-time events (devices shared with you by users on other servers)
SHELLY_WEBSOCKET_REGIONS=shelly-241-eu,shelly-242-eu
# Deprecated override of the token-exchange server; only set it if the server derived from the code is wrong
#SHELLY_REGION=shelly-241-eu
