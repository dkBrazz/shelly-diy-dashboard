# PostgreSQL / TimescaleDB
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shelly
DB_USER=postgres
DB_PASSWORD=replace-me

# Google OAuth application
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me

# Shelly Cloud
# OAuth token exchange region
SHELLY_REGION=shelly-241-eu
# Comma-separated regions monitored simultaneously for real-time events
SHELLY_WEBSOCKET_REGIONS=shelly-241-eu,shelly-242-eu
SHELLY_AUTH_CODE=replace-me
SHELLY_CLIENT_ID=shelly-diy
